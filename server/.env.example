APP_PORT=7819
APP_ENV=development
APP_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/riralicense?sslmode=disable

# Generate with: openssl rand -hex 32 (use distinct values for each)
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=

# Optional SMTP (leave SMTP_HOST empty in development for DEV-ONLY stdout logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@riralicense.local
SMTP_TLS=starttls

# Optional OAuth providers (leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
