APP_PORT=7819
APP_ENV=development
APP_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rira_license?sslmode=disable

# Generate with: openssl rand -hex 32 (64 hex chars = 32 bytes, use distinct values for each)
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=

# Database Pool & Timeouts
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_QUERY_TIMEOUT=5s
HTTP_TIMEOUT=15s
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional SMTP (Mailpit local dev: SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_TLS=none)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@riralicense.local
SMTP_TLS=none

# Optional OAuth providers (leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
